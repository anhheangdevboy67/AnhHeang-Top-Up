# ---- Server ----
PORT=5000
# Public URL of THIS backend once deployed (used to build return_url/cancel_url for PayWay)
PUBLIC_BASE_URL=https://your-backend-domain.com
# Public URL of the frontend (used for CORS + post-payment redirect)
FRONTEND_URL=https://your-frontend-domain.com

# ---- ABA PayWay credentials ----
# Get these by registering a sandbox account: https://developer.payway.com.kh/
ABA_MERCHANT_ID=your_sandbox_merchant_id
ABA_API_KEY=your_sandbox_api_key

# sandbox first, switch to production when you're ready to go live:
ABA_BASE_URL=https://checkout-sandbox.payway.com.kh
# ABA_BASE_URL=https://checkout.payway.com.kh

# ---- Game credit supplier (fulfillment) ----
# You don't have this yet. Once you sign with a top-up reseller/distributor,
# put their API base URL + key here. See lib/fulfillment.js for the integration point.
SUPPLIER_API_URL=
SUPPLIER_API_KEY=
